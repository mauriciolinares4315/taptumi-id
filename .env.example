# Copia este archivo a .env para desarrollo local (no lo subas a git)

# Flask
SECRET_KEY=cambia-esta-clave-por-una-aleatoria-larga
SITE_NAME=ID de Emergencia

# Turso / libSQL
# Déjalas vacías para desarrollar con un archivo sqlite local (local.db)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Cloudinary (fotos de perfil) - https://cloudinary.com/users/register/free
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Segundos que dura "desbloqueada" la vista médica / edición en la sesión
UNLOCK_SESSION_SECONDS=600
